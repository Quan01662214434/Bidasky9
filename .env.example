# Telegram Bot Token từ @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram User ID của chủ quán (lấy từ @userinfobot)
OWNER_TELEGRAM_ID=

# Đường dẫn database
DATABASE_PATH=data/bida.db

# Đường dẫn lưu ảnh
PHOTO_STORAGE_PATH=data/photos

# Đường dẫn backup
BACKUP_PATH=data/backups

# Múi giờ
TIMEZONE=Asia/Ho_Chi_Minh

# Giờ bắt đầu ngày kinh doanh (HH:MM, mặc định 06:00)
BUSINESS_DAY_START=06:00

# Tiền quỹ mặc định (VND, số nguyên)
DEFAULT_FUND=200000

# Log level
LOG_LEVEL=INFO
